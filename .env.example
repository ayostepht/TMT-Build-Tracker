# Database file (default: /data/tmt.db in production, ./data/tmt.db in dev)
# DATABASE_URL=/data/tmt.db

# Public URL users reach the app at, no trailing slash. Optional.
#  - Unset (default): the app trusts the address each request arrives on, so both
#    http://<lan-ip>:3000 and an https reverse proxy that sends X-Forwarded-Proto
#    work. Auth cookies are then not marked Secure.
#  - Set: only this origin is accepted; use it when behind a proxy with https.
#    Required for OIDC (redirect URI is <PUBLIC_URL>/api/auth/callback/oidc).
# (BETTER_AUTH_URL and ORIGIN are accepted as older names.)
# PUBLIC_URL=https://tmt.example.com

# Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional single sign-on via OpenID Connect (e.g. Authentik). All three are required to enable it.
# Redirect URI to register with the provider: <PUBLIC_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://auth.example.com/application/o/tmt/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
