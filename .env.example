# Database file (default: /data/tmt.db in production, ./data/tmt.db in dev)
# DATABASE_URL=/data/tmt.db

# Public URL users reach the app at, no trailing slash. Optional.
#  - Unset (default): the app trusts the address each request arrives on, so both
#    http://<lan-ip>:3000 and an https reverse proxy that sends X-Forwarded-Proto
#    work. Auth cookies are then not marked Secure.
#  - Set: only this origin is accepted; use it when behind a proxy with https.
#    Required for OIDC (redirect URI is <PUBLIC_URL>/api/auth/callback/oidc).
# (BETTER_AUTH_URL and ORIGIN are accepted as older names.)
# PUBLIC_URL=https://tmt.example.com

# Required: openssl rand -hex 32. The server exits at start unless it is 32+ characters (trimmed),
# has 10+ distinct characters and is not an obvious placeholder (e.g. "changeme"); only
# NODE_ENV=development/test skips this, an unset NODE_ENV counts as production.
# Also derives the key for stored printer access codes: changing it makes them unreadable.
BETTER_AUTH_SECRET=

# Optional. Comma-separated emails that are site admins (template kits, 3D models)
# in addition to the first account created on this install (case-insensitive).
# ADMIN_EMAILS=you@example.com

# Optional single sign-on via OpenID Connect (e.g. Authentik). All three are required to enable it.
# Redirect URI to register with the provider: <PUBLIC_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://auth.example.com/application/o/tmt/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik

# Optional. Largest 3MF (MB) accepted for plates and kit imports, default 1024 (256 when TMT_MODE=public). Sliced projects with
# G-code for every plate can be several hundred MB. Keep BODY_SIZE_LIMIT (1100M in the image) above it
# (at least MAX_3MF_MB + 1 MB); the server logs a warning at start if it is not. Every other route
# accepts at most 1 MB per request (photos 9 MB, STEP zips 200 MB, guide pages 3 MB), whatever
# BODY_SIZE_LIMIT says.
# MAX_3MF_MB=1024

# Optional limits (QUOTA_*). Each is a whole number (0 forbids the thing) or "off" for unlimited.
# Self-hosted installs default to no limits; TMT_MODE=public has finite defaults (shown).
# They are read and validated at start (a malformed value stops the server with a clear message).
# QUOTA_BUILDS_PER_WORKSPACE=10
# QUOTA_DRAFTS_PER_USER=20
# QUOTA_CHAPTERS_PER_USER=3
# QUOTA_MEMBERS_PER_CHAPTER=25
# QUOTA_PENDING_INVITES_PER_CHAPTER=25
# QUOTA_PHOTOS_PER_BUILD=100
# QUOTA_KIT_COPIES_PER_WORKSPACE=2
# QUOTA_CUSTOM_FILAMENTS_PER_WORKSPACE=50
# QUOTA_SAVED_DESIGNS_PER_USER=50
# QUOTA_UPLOAD_MB_PER_WORKSPACE=2048
# QUOTA_UPLOAD_MB_PER_USER=4096
# QUOTA_STEP_CONVERSIONS_PER_USER=1
# QUOTA_SSE_CONNECTIONS_PER_USER=12
# QUOTA_ACCOUNTS_TOTAL=500
# QUOTA_SIGNUPS_PER_DAY=50
# QUOTA_MEMBERSHIPS_PER_USER=10
# QUOTA_CONCURRENT_UPLOADS_PER_USER=2

# Optional. Free space (MB) the data volume must keep; uploads are refused with 507 below it.
# 0 or off = no check. Default 0 self-hosted, 2048 with TMT_MODE=public.
# MIN_FREE_DISK_MB=2048

# Optional. Per-user write rate limit on the API (POST/PUT/PATCH/DELETE; site admins exempt).
# WRITE_RATE_PER_MIN is the refill (whole number, or off); WRITE_RATE_BURST the bucket size. Over
# the limit a request gets 429 with Retry-After. Default with TMT_MODE=public: 120 per minute,
# burst 60. Self-hosted: off unless WRITE_RATE_PER_MIN is set (burst then defaults to half of it).
# WRITE_RATE_PER_MIN=120
# WRITE_RATE_BURST=60

# Optional. off = no background printer status connections.
# TMT_PRINTERS=off

# Optional. off = never download a kit pack (the one baked into the image is used).
# KITPACK_DOWNLOAD=off

# Optional. selfhost (default) or public (SSO-only hosted instance: Google/GitHub sign-in, no
# passwords, generic OIDC_* refused, no printers or Spoolman). Public mode refuses to start without:
# an https PUBLIC_URL on a real host name (no credentials, path, localhost or IP), a Google/GitHub
# pair, ADDRESS_HEADER (trusted proxy) and ADMIN_EMAILS. Other values fail at start.
# TMT_MODE=selfhost

# Optional. Self-hosted sign-up: open (default), invite or closed. invite/closed still allow the very
# first account. Use invite or closed when the app is reachable from the internet and whenever OIDC
# is used (with open, someone can register an address before its owner and block their SSO login).
# Does not apply in public mode.
# SIGNUP=open

# Optional. Google / GitHub sign-in (public mode); each needs both of its variables. Redirect URIs:
# <PUBLIC_URL>/api/auth/callback/google and <PUBLIC_URL>/api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Reverse-proxy trust. Also decides the client address used for sign-in rate limits. Set
# ADDRESS_HEADER only when ALL traffic comes through a proxy you control that overwrites this header
# (any header other than X-Forwarded-For is used verbatim). XFF_DEPTH: proxies to skip from the right
# of X-Forwarded-For, digits only, default 1. When unset, a client-sent X-Forwarded-For is ignored.
# When set but the header is missing, sign-in requests get 400 and a line is logged.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
